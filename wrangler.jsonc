{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homerun-king",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "build": { "command": "node tools/build.mjs" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "LOBBY", "class_name": "Lobby" },
      { "name": "PADS", "class_name": "Pad" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Lobby"] }, { "tag": "v2", "new_sqlite_classes": ["Pad"] }]
}
